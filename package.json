{
  "name": "peek-and-poke",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:smoke:live": "node --env-file=.env.local scripts/live-security-smoke.mjs",
    "security:smoke:realtime:live": "node --env-file=.env.local scripts/live-realtime-auth-smoke.mjs",
    "native:start": "npm run start -w @peekpoke/native",
    "native:start:go": "npm run start:go -w @peekpoke/native",
    "native:android": "npm run android -w @peekpoke/native",
    "native:android:dev": "npm run android:dev -w @peekpoke/native",
    "native:android:release": "npm run android:release -w @peekpoke/native",
    "native:ios": "npm run ios -w @peekpoke/native",
    "native:prebuild": "npm run prebuild -w @peekpoke/native --",
    "native:eas:dev:ios": "npm run eas:dev:ios -w @peekpoke/native",
    "native:eas:dev:android": "npm run eas:dev:android -w @peekpoke/native",
    "native:lint": "npm run lint -w @peekpoke/native",
    "native:typecheck": "npm run typecheck -w @peekpoke/native",
    "native:test": "npm run test -w @peekpoke/native",
    "native:test:ios": "npm run test:ios -w @peekpoke/native",
    "native:test:android": "npm run test:android -w @peekpoke/native",
    "native:maintenance": "bash scripts/dev-maintenance.sh",
    "deps:check": "npm ls --workspaces --include-workspace-root --depth=0",
    "storage:migrate-private": "node --env-file=.env.local scripts/migrate-private-storage.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@peekpoke/shared": "*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.89.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/supercluster": "^7.1.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.469.0",
    "mapbox-gl": "^3.12.0",
    "next": "^16.2.12",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-map-gl": "^8.1.0",
    "sharp": "^0.34.5",
    "stripe": "^20.1.2",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@libpg-query/parser": "^17.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.15",
    "react-doctor": "^0.8.1",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
