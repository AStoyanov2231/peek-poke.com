{
  "name": "@peekpoke/native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/run-expo.cjs start --dev-client",
    "start:go": "node scripts/run-expo.cjs start",
    "android": "bash scripts/run-android-dev.sh",
    "android:dev": "bash scripts/run-android-dev.sh",
    "android:release": "bash scripts/run-android-release.sh",
    "ios": "node scripts/run-expo.cjs run:ios",
    "prebuild": "node scripts/run-expo.cjs prebuild",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:android": "eas build --profile development --platform android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts && jest --config jest.marker.config.cjs --runInBand",
    "test:ios": "NATIVE_TEST_PLATFORM=ios vitest run --config vitest.config.ts && NATIVE_TEST_PLATFORM=ios jest --config jest.marker.config.cjs --runInBand",
    "test:android": "NATIVE_TEST_PLATFORM=android vitest run --config vitest.config.ts && NATIVE_TEST_PLATFORM=android jest --config jest.marker.config.cjs --runInBand"
  },
  "dependencies": {
    "@peekpoke/design": "*",
    "@peekpoke/shared": "*",
    "@rnmapbox/maps": "^10.3.2",
    "@supabase/supabase-js": "2.89.0",
    "@tanstack/react-query": "^5.90.20",
    "expo": "~57.0.4",
    "expo-auth-session": "~57.0.5",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-worklets": "0.10.1",
    "supercluster": "^8.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^19",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
